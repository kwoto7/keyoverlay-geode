{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081"
  },
  "id": "kwoto.hold_overlay",
  "name": "Hold Overlay",
  "version": "v1.1.0",
  "developer": "Kwoto",
  "description": "Scrolling jump-hold bars with custom button images.",
  "resources": {
    "sprites": ["duck.png"]
  },
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "default": true
    },
    "show-image": {
      "type": "bool",
      "name": "Show button image",
      "default": true
    },
    "button-image": {
      "type": "file",
      "name": "Custom button image",
      "description": "Choose a PNG or JPG. Leave empty or reset to use the duck. Keep your chosen file in the same location. Square images fit best.",
      "default": "",
      "control": {
        "dialog": "open",
        "filters": [
          {
            "files": ["*.png", "*.jpg", "*.jpeg"],
            "description": "Images (PNG, JPG)"
          }
        ]
      }
    },
    "show-counter": {
      "type": "bool",
      "name": "Show counter on button",
      "default": false
    },
    "show-p2": {
      "type": "bool",
      "name": "Show player 2",
      "default": false
    },
    "show-cps": {
      "type": "bool",
      "name": "Show CPS instead of total clicks",
      "default": false
    },
    "fade": {
      "type": "bool",
      "name": "Fade bars at the top",
      "default": true
    },
    "x": {
      "type": "float",
      "name": "Position X",
      "default": 20,
      "min": 0,
      "max": 2000
    },
    "y": {
      "type": "float",
      "name": "Position Y",
      "default": 20,
      "min": 0,
      "max": 1200
    },
    "width": {
      "type": "float",
      "name": "Key and bar width",
      "default": 22,
      "min": 8,
      "max": 100
    },
    "height": {
      "type": "float",
      "name": "History height",
      "default": 130,
      "min": 30,
      "max": 500
    },
    "speed": {
      "type": "float",
      "name": "Scroll speed",
      "default": 150,
      "min": 20,
      "max": 600
    },
    "scale": {
      "type": "float",
      "name": "Overlay scale",
      "default": 1,
      "min": 0.25,
      "max": 3
    },
    "opacity": {
      "type": "float",
      "name": "Opacity percent",
      "default": 100,
      "min": 5,
      "max": 100
    }
  }
}
